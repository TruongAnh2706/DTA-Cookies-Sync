{
  "manifest_version": 3,
  "name": "DTA Cookies Sync",
  "version": "1.0.0",
  "description": "Đồng bộ Cookies YouTube & Bilibili thời gian thực về ứng dụng DTA AutoDown",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
